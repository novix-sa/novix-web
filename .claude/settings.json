{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git rebase --continue)",
      "Bash(git rebase --abort)",
      "Bash(git revert *)",
      "Bash(git push origin main)",
      "Bash(git config user.name *)",
      "Bash(git config user.email *)",
      "Bash(git remote -v)",
      "Bash(git rev-parse *)",
      "Bash(git --version)",
      "Bash(gh --version)",
      "Bash(gh auth status *)",
      "Bash(gh auth login *)",
      "Bash(gh auth setup-git *)",
      "Bash(gh api user *)",
      "Bash(gh api repos/novix-sa/novix-web*)",
      "Bash(python3 .claude/preview_server.py *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push origin +*)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(gh api * -X *)",
      "Bash(gh api * --method *)"
    ]
  }
}
